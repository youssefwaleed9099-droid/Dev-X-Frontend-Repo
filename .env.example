# Runtime
NODE_ENV=production
PORT=3000

# Production database (recommended: managed PostgreSQL such as Neon)
# Use the pooled PostgreSQL connection string from your provider when available.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=10000

# Session / security
COOKIE_SECURE=true
COOKIE_SAMESITE=Lax
TRUST_PROXY=true

# Paymob - TEST first, then replace with LIVE credentials after merchant approval
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMOB_NOTIFICATION_URL=https://YOUR-DOMAIN.example/api/payments/paymob/webhook
PAYMOB_REDIRECT_URL=https://YOUR-DOMAIN.example/payment-result
PAYMOB_CHECKOUT_URL=

# Local testing: use NODE_ENV=development and COOKIE_SECURE=false on plain http://localhost:3000. Keep secure cookies in real HTTPS production.
# Local testing only: exposes the one-time reset token in the API response. Keep false in real production.
ALLOW_DEV_RESET_TOKEN=false
PASSWORD_RESET_BASE_URL=http://localhost:3000
